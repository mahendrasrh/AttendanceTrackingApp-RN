{
  "expo": {
    "name": "Work Trace",
    "slug": "WorkTrace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "work-trace",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.worktrace.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses your location to track attendance.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app uses your location to track attendance even when in the background."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyCJj6ureATirX-BcKNDIkEV0TlMWs-wnmA"
      }
    },
    "android": {
      "package": "com.yourname.worktrace",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCJj6ureATirX-BcKNDIkEV0TlMWs-wnmA"
        }
      }
    },
    "extra": {
      "API_BASE_URL": "https://worktrace.in/attendanceTracking-Backend",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5f025558-e9dc-4cee-ac1b-bdcec5f7d6ac"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "mahendranative"
  }
}