{
  "expo": {
    "name": "Work Trace",
    "slug": "Work Trace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",

    "scheme": "Work Trace",
    "userInterfaceStyle": "automatic",

    "newArchEnabled": false,

    "ios": {
      "bundleIdentifier": "com.yourname.worktrace"
    },

    "android": {
      "package": "com.yourname.worktrace",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCJj6ureATirX-BcKNDIkEV0TlMWs-wnmA"
        }
      }
    },

    "extra": {
       "API_BASE_URL": "https://worktrace.in/attendanceTracking-Backend",
      "router": {
        "origin": false
      }
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
